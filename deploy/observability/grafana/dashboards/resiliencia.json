{
  "uid": "circleguard-resiliencia",
  "title": "CircleGuard · Resiliencia (Circuit Breaker)",
  "description": "Estado de los circuitos de Resilience4j de auth → identity y dashboard → promotion (HU-17).",
  "tags": [
    "circleguard",
    "hu-20"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "state-timeline",
      "title": "Estado del circuito (identity y promotion)",
      "description": "Cerrado: se llama al servicio. Abierto: se responde al instante sin llamarlo. Semiabierto: llamadas de prueba.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            {
              "type": "range",
              "options": {
                "from": -0.5,
                "to": 0.5,
                "result": {
                  "text": "CERRADO",
                  "color": "green",
                  "index": 0
                }
              }
            },
            {
              "type": "range",
              "options": {
                "from": 0.5,
                "to": 1.5,
                "result": {
                  "text": "SEMIABIERTO",
                  "color": "yellow",
                  "index": 1
                }
              }
            },
            {
              "type": "range",
              "options": {
                "from": 1.5,
                "to": 2.5,
                "result": {
                  "text": "ABIERTO",
                  "color": "red",
                  "index": 2
                }
              }
            }
          ],
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "always",
        "mergeValues": true,
        "legend": {
          "showLegend": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "2 * max by (name) (resilience4j_circuitbreaker_state{state=\"open\"}) + max by (name) (resilience4j_circuitbreaker_state{state=\"half_open\"})",
          "refId": "A",
          "legendFormat": "{{name}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Tasa de fallas en la ventana del circuito",
      "description": "Se abre al llegar al 50 % con al menos 5 llamadas (-1 = aún sin datos suficientes).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (name) (resilience4j_circuitbreaker_failure_rate >= 0)",
          "refId": "A",
          "legendFormat": "{{name}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Llamadas rechazadas con el circuito abierto (por minuto)",
      "description": "Cada una es una petición que no esperó un timeout: se degradó al instante.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (name) (rate(resilience4j_circuitbreaker_not_permitted_calls_total[1m])) * 60",
          "refId": "A",
          "legendFormat": "{{name}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Reintentos (por minuto)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (name, kind) (rate(resilience4j_retry_calls_total[1m])) * 60",
          "refId": "A",
          "legendFormat": "{{name}} {{kind}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Login: respuestas por código (por minuto)",
      "description": "Con identity caído el login responde 503 (degradado) en lugar de 500.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (status) (rate(http_server_requests_seconds_count{application=\"circleguard-auth-service\", uri=\"/api/v1/auth/login\"}[1m])) * 60",
          "refId": "A",
          "legendFormat": "HTTP {{status}}"
        }
      ]
    }
  ]
}
