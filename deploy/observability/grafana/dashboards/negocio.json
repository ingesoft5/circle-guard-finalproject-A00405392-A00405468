            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(circleguard_promotions_total{status=~\"SUSPECT|PROBABLE|CONFIRMED\"}[1h]))",
          "refId": "A",
          "legendFormat": "personas"
        }
      ]
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Contención p95 (última hora)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 16,
        "w": 6,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
