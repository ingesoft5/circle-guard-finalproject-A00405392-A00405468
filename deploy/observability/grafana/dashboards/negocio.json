{
  "uid": "circleguard-negocio",
  "title": "CircleGuard · Negocio",
  "description": "Métricas de negocio propias (Micrometer): promociones, tiempo de contención, check-ins y cuestionarios.",
  "tags": [
    "circleguard",
    "hu-20"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Promociones por minuto (por estado)",
      "description": "Personas que entran al cerco por minuto: la que reporta y sus contactos de nivel 1 y 2.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (status) (rate(circleguard_promotions_total{status=~\"SUSPECT|PROBABLE|CONFIRMED\"}[5m])) * 60",
          "refId": "A",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Tiempo de contención (p95 y promedio)",
      "description": "Desde que la persona envía el cuestionario con síntomas hasta que su cerco queda aplicado en promotion.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(circleguard_containment_time_seconds_bucket[15m])))",
          "refId": "A",
          "legendFormat": "p95"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(circleguard_containment_time_seconds_sum[15m])) / clamp_min(sum(rate(circleguard_containment_time_seconds_count[15m])), 1e-9)",
          "refId": "B",
          "legendFormat": "promedio"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Check-ins por minuto (por resultado)",
      "description": "Validaciones de QR en la puerta: entra, en cerco, QR inválido o estado no disponible.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (result) (rate(circleguard_gate_checkins_total[5m])) * 60",
          "refId": "A",
          "legendFormat": "{{result}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Cuestionarios por minuto",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (symptoms) (rate(circleguard_surveys_submitted_total[5m])) * 60",
          "refId": "A",
          "legendFormat": "síntomas={{symptoms}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Check-ins (última hora)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 6,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(circleguard_gate_checkins_total[1h]))",
          "refId": "A",
          "legendFormat": "check-ins"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Accesos negados por riesgo (última hora)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 16,
        "w": 6,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(circleguard_gate_checkins_total{result=\"denied_risk\"}[1h]))",
          "refId": "A",
          "legendFormat": "negados"
        }
      ]
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Personas promovidas al cerco (última hora)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 6,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
