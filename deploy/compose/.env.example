# Copia este archivo a deploy/compose/<env>/.env y llena los valores. El .env NUNCA se versiona.
# Para generar un secreto:  openssl rand -hex 32

# Imagen a desplegar (la define el pipeline). REGISTRY = Nexus, p. ej. 172.31.32.157:8082
REGISTRY=local
IMAGE_TAG=dev

# Puerto público del cliente web
WEB_PORT=80

# PostgreSQL
DB_USER=circleguard
DB_PASSWORD=

# Neo4j (mínimo 8 caracteres)
NEO4J_PASSWORD=

# Firmas JWT y QR: el mismo valor en todos los servicios (mínimo 32 caracteres)
JWT_SECRET=
QR_SECRET=

# Bóveda de identidad (identity): clave en hexadecimal de 64 caracteres y sales en hexadecimal
VAULT_SECRET=
VAULT_SALT=
VAULT_HASH_SALT=

# LDAP opcional: si no se define, auth usa solo las cuentas locales
# LDAP_URL=ldap://ldap:389
# LDAP_PASSWORD=
