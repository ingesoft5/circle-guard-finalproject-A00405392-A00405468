# Plantilla de nginx: la imagen oficial reemplaza ${VARIABLES} al arrancar (envsubst).
# Los upstreams se resuelven en cada petición (resolver + variables), así nginx arranca
# aunque un servicio no esté desplegado (en la Parte 1 solo corren 5 de los 8).

map $api_service $api_upstream {
    auth          ${AUTH_UPSTREAM};
    identity      ${IDENTITY_UPSTREAM};
    form          ${FORM_UPSTREAM};
    promotion     ${PROMOTION_UPSTREAM};
    gateway       ${GATEWAY_UPSTREAM};
    dashboard     ${DASHBOARD_UPSTREAM};
    file          ${FILE_UPSTREAM};
    notification  ${NOTIFICATION_UPSTREAM};
}

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;
    client_max_body_size 20m;
    resolver ${NGINX_RESOLVER} valid=10s ipv6=off;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Versión desplegada (p. ej. "1.1.0"): el compose la fija con APP_VERSION (= IMAGE_TAG) al arrancar el
    # contenedor. Sirve para comprobar qué versión corre en cada ambiente, también tras un rollback.
    location = /version {
        access_log off;
        default_type text/plain;
        add_header Cache-Control "no-store" always;
        return 200 "${APP_VERSION}\n";
    }

    # /api/<servicio>/<ruta>  ->  http://<upstream>/<ruta>
    # Se quita el prefijo con rewrite y proxy_pass va SIN ruta: así nginx vuelve a codificar la ruta
    # (espacios, tildes) y conserva el query string. Con proxy_pass http://$up/$captura la ruta llegaba
    # decodificada al servicio (p. ej. "/department/Faculty of Engineering"), una solicitud HTTP inválida.
    location ~ ^/api/(?<api_service>auth|identity|form|promotion|gateway|dashboard|file|notification)/ {
        rewrite ^/api/[^/]+/(.*)$ /$1 break;
        proxy_pass http://$api_upstream;
        proxy_http_version 1.1;
        # $http_host conserva el puerto: con $host, Spring veía un Origin (host:puerto) distinto del Host y
        # rechazaba con 403 (CORS) las peticiones del propio navegador cuando el web no está en el puerto 80.
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
    }

    # Archivos generados por Expo (llevan hash en el nombre): caché larga.
    location /_expo/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # Rutas de la app: Expo genera un .html por ruta; lo demás cae en index.html.
    location / {
        try_files $uri $uri.html $uri/ /index.html;
    }
}
