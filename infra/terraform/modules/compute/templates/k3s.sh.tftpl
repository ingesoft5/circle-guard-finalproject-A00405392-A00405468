#!/usr/bin/env bash
# Generado por Terraform (modulo compute, role = k3s). Corre una sola vez, al crear la VM.
# El registro queda en /var/log/circleguard-bootstrap.log.
set -euo pipefail
exec > >(tee -a /var/log/circleguard-bootstrap.log) 2>&1

hostnamectl set-hostname "${hostname}"
export DEBIAN_FRONTEND=noninteractive
apt-get update -y
apt-get install -y curl ca-certificates

# k3s: Kubernetes certificado y ligero. --tls-san deja llegar al API por la IP elastica.
curl -sfL https://get.k3s.io | INSTALL_K3S_VERSION='${k3s_version}' sh -s - server --tls-san '${public_ip}'
